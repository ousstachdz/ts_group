<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="invoice_report_main">
            <t t-call="web.html_container">    
                <t t-foreach="docs" t-as="o">
                        <div t-attf-class="header" style="border-bottom: 3px solid #084165; padding-bottom: 8px;">
                            <div class="o_boxed_header">
                                <div class="row mb8">
                                    <div class="col-2 mb2 mt2">
                                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" style="width:240px;height:85px"/>
                                    </div>
                                    <div class="col-6 text-center">
                                        
                                    </div>
                                    <div class="col-3 mb2 mt2">
                                        <img t-att-src="'/ts_group_process/static/img/tsg_logo.png'" alt="Logo" style="width:240px;height:85px"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div t-attf-class="footer">
                            <div class="row">
                                <div class="col-2">
                                </div>
                                <div class="col-8 text-center text-muted">
                                        <strong>Merci d'avoir choisi Notre Entreprise .</strong><br/>
                                        <strong>Merci pour votre confiance.</strong>
                                </div>
                                
                                <div class="text-end col-2">
                                    
                                    <small>
                                        <span>Page</span>
                                        <span class="page" />
                                        /
                                        <span class="topage" />
                                    </small>
                                </div>
                            </div>
                        </div>
                        <t t-call="web.external_layout">
                            <div class="page" style="color:black !important;">

                                <style>
                                    .invoice-table td,
                                    .invoice-table th,
                                    .invoide-table tr {
                                        border: 1px solid black;
                                    }
                                    p {
                                        padding: 0!important;
                                        margin:0!important;
                                    }
                                    .page{
                                        font-family: 'Arial' !important;
                                    }
                                </style>

                                <div class="row">
                                    <div class="col-6" name="company_details">
                                        <strong>
                                            <t t-esc="o.company_id.name" />
                                        </strong>
                                        <br/>
                                        <span t-if="o.company_id.partner_id.rc">
                                            <strong>R.C:</strong>
                                            <t t-esc="o.company_id.partner_id.rc" />
                                            <br/>
                                        </span>
                                        <span t-if="o.company_id.partner_id.nif">
                                            <strong>NIF:</strong>
                                            <t t-esc="o.company_id.partner_id.nif" />
                                            <br/>
                                        </span>
                                        <span t-if="o.company_id.partner_id.nis">
                                            <strong>NIS:</strong>
                                            <t t-esc="o.company_id.partner_id.nis" />
                                            <br/>
                                        </span>
                                        <span t-if="o.company_id.partner_id.ai">
                                            <strong>N° Art. :</strong>
                                            <t t-esc="o.company_id.partner_id.ai" />
                                            <br/>
                                        </span>
                                        <span t-if="o.company_id.partner_id.phone">
                                            <strong>N° Tél : </strong>
                                            <t t-esc="o.company_id.partner_id.phone" />
                                            <br/>
                                        </span>
                                        <span t-if="o.partner_bank_id.acc_number">
                                            <strong>RIB : </strong>
                                            <t t-esc="o.partner_bank_id.acc_number" />
                                            <br/>
                                        </span>
                                        <span>
                                            <strong>Adresse :</strong> 
                                            <t t-esc="o.company_id.partner_id.contact_address" />
                                        </span>
                                        
                                        
                                    </div>
                                    <div class="col-1">
                                    </div>
                                    <div class="col-5" name="client_details">
                                        <div>
                                            <strong>
                                                Client: 
                                                <t t-esc="o.partner_id.name" />
                                            </strong>
                                            <br/>
                                            <span t-if="o.partner_id.rc">
                                                <strong>R.C:</strong>
                                                <t t-esc="o.partner_id.rc" />
                                                <br/>
                                            </span>
                                            <span t-if="o.partner_id.nif">
                                                <strong>NIF:</strong>
                                                <t t-esc="o.partner_id.nif" />
                                                <br/>
                                            </span>
                                            <span t-if="o.partner_id.nis">
                                                <strong>NIS:</strong>
                                                <t t-esc="o.partner_id.nis" />
                                                <br/>
                                            </span>
                                            <span t-if="o.company_id.partner_id.ai">
                                                <strong>N° Art. :</strong>
                                                <t t-esc="o.partner_id.ai" />
                                                <br/>
                                            </span>
                                            <span t-if="o.company_id.partner_id.tin">
                                                <strong>TIN:</strong>
                                                <t t-esc="o.partner_id.tin" />
                                                <br/>
                                            </span>
                                            <span t-if="o.company_id.partner_id.phone">
                                                <strong>N° Tél : </strong>
                                                <t t-esc="o.partner_id.phone" />
                                                <br/>
                                            </span>
                                            <span t-if="o.company_id.partner_id.industry_id">
                                                <strong>Activité : </strong>
                                                <t t-esc="o.company_id.partner_id.industry_id.name" />
                                                <br/>
                                            </span>
                                            <span>
                                                <strong>Adresse :</strong>
                                                <t t-esc="o.partner_id.contact_address" />
                                            </span>
                                        </div>

                                    </div>
                                </div>
                                <div class="row mt-5">
                                    <div class="col-7">
                                        <h3 style="font-family: 'Arial';">
                                            <span>Facture N° :</span>
                                            <span t-if="o.name != '/'" t-field="o.name" />
                                        </h3>
                                    </div>
                                    <div class="col-4 text-start" name="invoice_date">
                                        <strong  style="font-family: 'Arial'; font-size: 14px;">Date:</strong>
                                        <span class="m-0" t-field="o.invoice_date" />
                                    </div>
                                </div>
                                
                                <div>
                                    <span><strong>Réf. Contrat:</strong> <span t-field="o.ref_contract" /></span>
                                </div>
                                <div>
                                    <span><strong>Réf. Bon de Commande:</strong><span t-field="o.ref" /></span>
                                </div>

                                <t t-set="display_discount"
                                    t-value="any(l.discount for l in o.invoice_line_ids)" />

                                <table class="table table-sm invoice-table" name="invoice_line_table">
                                    <thead style="background: #084165; width:100%!important;">
                                        <th name="th_description" class="text-center" style="color:white !important">
                                            <span>Désignation</span>
                                        </th>
                                        <th name="th_quantity" class="text-center" style="color:white !important">
                                            <span>Qte</span>
                                        </th>
                                        <th name="th_priceunit" class="text-center" style="color:white !important">
                                            <span>Unité</span>
                                        </th>
                                        <th name="th_priceunit" class="text-center" style="color:white !important">
                                            <span>Prix HT</span>
                                        </th>
                                        <th name="th_price_unit" t-if="display_discount" class="text-center" style="color:white !important">
                                            <span>Rem.%</span>
                                        </th>
                                        <th name="th_subtotal" class="text-center" style="color:white !important">
                                            <span>Prix Total HT</span>
                                        </th>
                                    </thead>
                                    <tbody class="invoice_tbody">
                                        <t t-set="current_subtotal" t-value="0" />
                                        <t t-set="lines"
                                            t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)" />

                                        <t t-foreach="lines" t-as="line">

                                            <t t-set="current_subtotal"
                                                t-value="current_subtotal + line.price_total" />
                                            <tr
                                                t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                                <t t-if="line.display_type == 'product'"
                                                    name="account_invoice_line_accountable">
                                                    <td name="account_invoice_line_name">
                                                        <span t-field="line.name"
                                                            t-options="{'widget': 'text'}" />
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-field="line.quantity" />
                                                    </td>
                                                    <td class="text-center">
                                                        
                                                        <span t-field="line.product_uom_id"
                                                            groups="uom.group_uom" />
                                                    </td>
                                                    <td
                                                        t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                        <span class="text-nowrap" t-field="line.price_unit" />
                                                    </td>
                                                    <td t-if="display_discount"
                                                        t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                        <span class="text-nowrap" t-field="line.discount"/>
                                                    </td>

                                                    <td class="text-center o_price_total">

                                                        <span class="text-nowrap" t-field="line.price_total" />
                                                    </td>
                                                </t>
                                                <t t-if="line.display_type == 'line_section'">
                                                    <td colspan="99">
                                                        <span t-field="line.name"
                                                            t-options="{'widget': 'text'}" />
                                                    </td>
                                                    <t t-set="current_section" t-value="line" />
                                                    <t t-set="current_subtotal" t-value="0" />
                                                </t>
                                                <t t-if="line.display_type == 'line_note'">
                                                    <td colspan="99">
                                                        <span t-field="line.name"
                                                            t-options="{'widget': 'text'}" />
                                                    </td>
                                                </t>
                                            </tr>

                                            <t
                                                t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                                <tr class="is-subtotal text-end">
                                                    <td colspan="99">
                                                        <strong class="mr16">Subtotal</strong>
                                                        <span
                                                            t-esc="current_subtotal"
                                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                        />
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>

                                <div class="clearfix mb-4">
                                    <div id="total" class="row">
                                        <div
                                            t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-4'} ms-auto">
                                            <table class="table table-sm invoice-table" style="page-break-inside: avoid;">
                                                <t t-if="o.tax_totals" t-call="account.document_tax_totals">
                                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                                    <t t-set="currency" t-value="o.currency_id"/>
                                                </t>
                                            </table>
                                        </div>
                                    </div>

                                </div>

                                <div class="mb-4" style="page-break-inside: avoid;">
                                    <p>
                                        <strong>Arrêtée la présente facture à la somme de:</strong>
                                        <span t-esc="o.currency_id.amount_to_text(o.amount_total)" />
                                    </p>
                                    
                                </div>
                                <div style="page-break-inside: avoid;">
                                    <strong>CONDITIONS DE PAIMENT:</strong><br/>
                                    <t t-out="o.company_id.invoice_terms" class="text-dark"/>
                                    
                                </div>
                            </div>
                        </t>
                    
                </t>
            </t>
        </template>


        <!-- <template id="invoice_report_main">
            <t t-call="ts_group_process.external_layout_boxed_inherit_ts_group"/>
            <t t-raw="0" />
        </template> -->


    </data>
</odoo>