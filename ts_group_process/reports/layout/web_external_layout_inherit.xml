<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="external_layout_boxed_inherit_ts_group">
        <div t-attf-class="header" t-att-style="report_header_style">
            <div class="o_boxed_header">
                <div class="row mb8">
                    <div class="col-2 mb2 mt2">
                        <img t-if="o.env.user.company_id.logo" t-att-src="image_data_uri(o.env.user.company_id.logo)" alt="Logo" style="width:180px;height:85px"/>
                    </div>
                    <div class="col-8 text-center">
                        
                    </div>
                </div>
            </div>
        </div>
        
        <div t-attf-class="footer">
            <div class="text-center">
                
                <table cellspacing="0" cellpadding="0" width="100%" style="padding-bottom:5px;">
                    <tr>
                        <td style="text-align:center">
                            <small>
                                <span>Page</span>
                                <span class="page" />
                                /
                                <span class="topage" />
                            </small>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    

</odoo>