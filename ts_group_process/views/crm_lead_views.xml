<?xml version="1.0" ?>
<odoo>
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.lead</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="ref_contract"/>
                
            </xpath>
            <page name="extra" position="after">
                <page name="products" string="Products">
                    <field name="lead_line_ids">
                        <list string="Products" editable="bottom">
                            <field name="product_id"/>
                            <field name="name" widget="section_and_note_text" />
                            <field name="uom_id" string='Unité de mesure' readonly='0'/>
                            <field name="product_qty" string="Quantity" />
                            <field name="price_unit" string="Price Unit" />
                            <field name="taxes_id" string="Taxes" widget="many2many_tags" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    
    <record id="crm_lead_inherit_view_search" model="ir.ui.view">
        <field name="name">crm.lead.inherit.view.search</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group/filter[@name='salesperson']" position="before">
                <filter string="Ref. Contract" name="ref_contract" context="{'group_by':'ref_contract'}"/>
            </xpath>
            
        </field>
    </record>

</odoo>
