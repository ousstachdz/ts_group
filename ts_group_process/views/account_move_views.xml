<?xml version="1.0" ?>
<odoo>
    <record id="account_move_view_form_inherit" model="ir.ui.view">
        <field name="name">account.move.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>    
            </xpath>  
            <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_user_id']" position="after">
                <field name="posted_by" readonly="1"/>
            </xpath>
            <xpath expr="//button[@name='action_post'][1]" position="attributes">
                <attribute name="groups">ts_group_process.group_confirm_invoice</attribute>  
                
            </xpath> 
            <xpath expr="//button[@name='action_post'][2]" position="attributes">
                <attribute name="groups">ts_group_process.group_confirm_invoice</attribute>  
                
            </xpath> 
        </field>
    </record>

    

</odoo>
